# 控制指令枚举
uint8 CMD_PAUSE = 1
uint8 CMD_RESUME = 2
uint8 CMD_STOP_AND_RESET = 3
uint8 CMD_UPDATE_PARAMS = 4  # 🌟 更新倍速和停留时间
uint8 CMD_JUMP_TO_TIME = 5   # 🌟 跳转到指定时间点
uint8 CMD_UPDATE_FRAME_HOLD = 6   #修改单帧关键帧停留时间  
uint8 CMD_SWITCH_MODE = 7      # 新增常量：切换控制模式

string ip                    # 目标灵巧手的 IP 地址
uint8 command                # 执行哪条指令
float64 playback_rate        # 仅在指令 4 时使用
float64 keyframe_hold_s      # 在指令 4/6 时使用
float64 target_time          # 在指令 5/6 时使用，
float64 max_joint_speed_deg_s   # 仅在指令 4 时使用
float64 loop_transition_s    # 仅在指令 4 时使用
bool loop
bool yoyo
bool use_discrete_mode false   # 新增字段：当 command == 7 时，读取此字段切换模式

---
bool success
string message